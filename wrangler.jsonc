{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artiling-jobs",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-20",
  "vars": {
    "TEAM_DOMAIN": "https://dawn-term-988b.cloudflareaccess.com",
    "POLICY_AUD": "f623bdeba681df0d84d0631f851e068ebab7b7b93581d9a42b68a4a8d737ff19"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artiling-jobs-production",
      "database_id": "1b90a73e-0371-464f-9887-819f03d5e360",
      "preview_database_id": "DB"
    }
  ]
  // Document file storage. Cloudflare validates bindings at deploy time, so this
  // block can only be added once the bucket exists, otherwise every deploy fails.
  // Create an R2 bucket named artiling-jobs-documents, then add:
  //
  // "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "artiling-jobs-documents" }]
  //
  // Until then /api/files answers 503 with an explanation. Bindings must be
  // declared here rather than in the dashboard, because this file is the source
  // of truth for the project.
}
